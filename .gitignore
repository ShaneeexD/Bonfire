# ---------------------------------------------------------------------------
# Secrets and machine-specific settings: never commit these.
# See "Files that stay on your machine" in README.md.
# (Note: .gitignore only allows comments on their own lines.)
# ---------------------------------------------------------------------------
# Local `wrangler dev` keys (a copy of server/.dev.vars.example).
server/.dev.vars
# Production READ_KEY / WRITE_KEY.
server/.deploy-keys.env
# Your Worker's URL, read by the samples.
server/.deployed-url
# Cloudflare API token and account ID for the admin editor's usage meter.
server/.analytics-token
server/.cloudflare-account
.env
.env.*
!.env.example
*.pem
*.key

# ---------------------------------------------------------------------------
# Node / Cloudflare Wrangler
# ---------------------------------------------------------------------------
node_modules/
.wrangler/
# Generated by `wrangler types` (npm install runs it).
server/worker-configuration.d.ts
npm-debug.log*
coverage/

# ---------------------------------------------------------------------------
# .NET
# ---------------------------------------------------------------------------
bin/
obj/
TestResults/
publish/
# Release zips built by scripts/publish.ps1.
dist/
*.user
*.suo
*.nupkg
*.snupkg

# ---------------------------------------------------------------------------
# Editors and OS clutter
# ---------------------------------------------------------------------------
.vs/
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
*.log
